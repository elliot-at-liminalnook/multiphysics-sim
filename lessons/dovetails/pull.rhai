// The tail is pulled out harder and harder: 100 N per second up to 200 N.
zoom("tail", 1.1, 1.0);
speed(0.5);
caption("Pulling the tail straight out of its socket, harder and harder");
highlight("joint");
at(0.6);
caption("The flanks press on the socket: the walls are pushed apart, much harder than the pull");
highlight("socket");
at(1.4);
caption("At 200 N of pull, each wall is pushed out with far more than 200 N");
highlight("joint");
