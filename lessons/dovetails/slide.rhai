// A tight dovetail pushed along its groove, harder and harder (5 N per
// second). Friction on the preloaded flanks holds it until about 3.5 s.
zoom("slider", 1.1, 1.0);
speed(0.8);
caption("Pushing the tail along its groove: the tight fit presses both flanks");
highlight("fit");
at(3.0);
speed(0.4);
caption("The push passes the friction on the flanks: it breaks free");
highlight("slider");
at(4.2);
speed(0.6);
caption("It slides home against the end of the groove");
