          "label": "Shaft coupling",
          "kind": {
            "kind": "element",
            "component_type": "rotational.spring"
          },
          "parameters": {
            "stiffness": {
              "value": 30.0,
              "provenance": {
                "kind": "estimated",
                "explanation": "Small beam coupling, 5 mm bore: catalogue range 20–60 N·m/rad."
              }
            }
          },
          "placement": {
            "position": [
              -0.016,
