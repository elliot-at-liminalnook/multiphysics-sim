{"batch_size":64,"epochs":30,"learning_rate":0.001,"recipe":{"axes":[{"index":0,"kind":"joint","name":"joint.left axle","position_kind":"Angle"},{"index":1,"kind":"joint","name":"joint.right axle","position_kind":"Angle"},{"index":2,"kind":"joint","name":"joint.passive axle","position_kind":"Angle"},{"axis":0,"kind":"link","link":"chassis","name":"reference.0"},{"axis":1,"kind":"link","link":"chassis","name":"reference.1"},{"axis":2,"kind":"link","link":"chassis","name":"reference.2"}],"controller_context":{"initial_targets_rad":[0.01,-0.02],"motion_gate":null,"period_s":0.02,"policy":{"imu_observations":["body imu"],"observation_source":"ideal_joint_state_diagnostics","target_bounds_rad":{"joint.left axle":[-200,200],"joint.right axle":[-200,200]}},"program":{"inputs":[{"initial":0,"kind":"AngularVelocity","lower":-10,"name":"command.left_speed","upper":10},{"initial":0,"kind":"AngularVelocity","lower":-10,"name":"command.right_speed","upper":10}],"parameters":{"initial_left":0.01,"initial_right":-0.02,"period_s":0.02},"sources":{"entry":"velocity-controller.rhai","files":{"velocity-controller.rhai":"// Integrate requested shaft velocity into a position reference. The ordinary\n// CAD motor, gearbox and firmware execute it; this does not move physical state.\nfn control(t, sensors, commands, state) {\n    let p = parameters();\n    let left = if state.contains(\"left\") { state.left } else { p.initial_left };\n    let right = if state.contains(\"right\") { state.right } else { p.initial_right };\n    state.left = left + p.period_s * sensors[\"command.left_speed\"];\n    state.right = right + p.period_s * sensors[\"command.right_speed\"];\n    commands[\"left axle.target\"] = state.left;\n    commands[\"right axle.target\"] = state.right;\n    #{commands: commands, state: state}\n}\n"}}},"target_trajectory":null},"controller_inputs":[{"initial":0,"kind":"AngularVelocity","lower":-10,"name":"command.left_speed","upper":10},{"initial":0,"kind":"AngularVelocity","lower