        "n": {
          "label": "Supply −"
        },
        "p": {
          "label": "Supply +"
        },
        "shaft": {
          "label": "Output shaft"
        }
      },
      "parameters": {
        "k": {
          "unit": "N·m/A",
          "default": 0.012,
          "description": "Motor constant k = k_t = k_e"
        },
        "resistance": {
          "unit": "Ω",
          "default": 2.0,
          "description": "Winding resistance"
        }
      },
      "instances": {
